{
  "name": "gyaruinthemix-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:api": "node --env-file=.env api/server.mjs",
    "test:ui-api": "node tests/preview-api.mjs",
    "images": "node scripts/images.mjs",
    "build": "npm run images && astro build && node scripts/check-site-build.mjs",
    "start": "node api/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . && prettier --check .github/workflows src config deploy Dockerfile* *.json *.mjs *.md api/*.mjs tests/*.mjs scripts/*.mjs",
    "format": "prettier --write .github/workflows src config deploy Dockerfile* *.json *.mjs *.md api/*.mjs tests/*.mjs scripts/*.mjs",
    "smoke": "node scripts/smoke.mjs",
    "security:scan": "bash scripts/scan-secrets.sh history",
    "security:hooks": "bash scripts/install-hooks.sh",
    "test:secret-scan": "node scripts/test-secret-scan.mjs",
    "test:deployment": "python3 -m unittest discover -s tests -p \"test_bouncer*.py\""
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "astro": "7.3.3",
    "eslint": "10.11.0",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.35.4"
  }
}
