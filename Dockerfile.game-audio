# Match the website's reviewed Node 24 base; verify this tag/digest during release.
FROM node:24.21.0-alpine3.23
WORKDIR /app
COPY game-audio/server/app.mjs game-audio/server/start.mjs ./
COPY game-audio/deploy/healthcheck.mjs ./
USER 10001:10001
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD node /app/healthcheck.mjs
CMD ["node", "--max-old-space-size=48", "/app/start.mjs"]
