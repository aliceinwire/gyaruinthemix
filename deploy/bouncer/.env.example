# Default: static Stripe Payment Links, no API or Stripe secret files.
CHECKOUT_MODE=payment_links
# Optional custom cart only: set CHECKOUT_MODE=api and uncomment the next line.
# COMPOSE_PROFILES=checkout-api
# Configure public Payment Links in config/payment-links.json and config/products.json.
# Add these to ~/bouncer/.env; preserve existing values/project settings there.
# A single bare hostname. Never reuse znc.alicef.me.
STORE_DOMAIN=
LETSENCRYPT_EMAIL=alicef@alicef.me
# GitHub-hosted CI publishes these images after the main branch passes checks.
GYARUINTHEMIX_WEB_IMAGE=ghcr.io/aliceinwire/gyaruinthemix-web:main
GYARUINTHEMIX_API_IMAGE=ghcr.io/aliceinwire/gyaruinthemix-api:main
# For CHECKOUT_MODE=api, also change WEB_IMAGE to:
# GYARUINTHEMIX_WEB_IMAGE=ghcr.io/aliceinwire/gyaruinthemix-web-api:main
# Provisional caps: inspect current VPS memory before accepting them.
GYARUINTHEMIX_WEB_MEMORY_LIMIT=64m
GYARUINTHEMIX_API_MEMORY_LIMIT=192m
# The remaining STRIPE_* and SALES_* settings apply ONLY to optional API mode.
STRIPE_MODE=test
SALES_ENABLED=false
# Hidden /shop-test/ only; requires test mode and public sales disabled.
TEST_SHOP_ENABLED=false
STORE_DETAILS_REVIEWED=false
LIVE_MODE_ACK=
STRIPE_PRICE_STICKER=
STRIPE_PRICE_TOWEL=
STRIPE_PRICE_KEYCHAIN=
STRIPE_PRICE_TSHIRT=
STRIPE_SHIPPING_RATE_JP=
# Optional API mode only: Stripe keys are files in ./gyaruinthemix/secrets/.

# API mode requires restricted rk_test_... / rk_live_... keys. See SECURITY.md.
# Keep the key itself in the secret file, never in this environment file.
