# LOCAL DEVELOPMENT ONLY. Copy to .env and chmod 600 .env.
# For the only VPS deployment, use deploy/bouncer/.env.example in ~/bouncer/.env.
# NON-SECRET configuration only; keep keys in the files below, never in this file.
# Default: static Stripe Payment Links, no API or Stripe secret files required.
CHECKOUT_MODE=payment_links
# Configure public Payment Links in config/payment-links.json and config/products.json.
# For local custom-cart development, set CHECKOUT_MODE=api and run npm run dev:api.
# Production API mode also needs the API frontend image and checkout-api profile;
# follow deploy/bouncer/README.md rather than copying this local file to the VPS.
SITE_URL=http://localhost:4321
# All remaining settings apply ONLY to optional local API mode.
STRIPE_MODE=test
SALES_ENABLED=false
STORE_DETAILS_REVIEWED=false
LIVE_MODE_ACK=
STRIPE_SECRET_KEY_FILE=./secrets/stripe_secret_key
STRIPE_WEBHOOK_SECRET_FILE=./secrets/stripe_webhook_secret
STATE_DIR=./state
STRIPE_PRICE_STICKER=
STRIPE_PRICE_TOWEL=
STRIPE_PRICE_KEYCHAIN=
STRIPE_PRICE_TSHIRT=
STRIPE_SHIPPING_RATE_JP=
# API mode requires restricted rk_test_... / rk_live_... keys. See SECURITY.md.
# Run scripts/setup-secret.sh with --local to create protected local secret files.
