---
import ProductGallery from './ProductGallery.astro';
import { usesCart } from '../data/checkout.mjs';
import { getLocale, translator } from '../data/i18n.mjs';
import { localizeProduct } from '../data/shop-i18n.mjs';
import { money } from '../scripts/cart.mjs';
const {
  product: definition,
  index = 0,
  cartEnabled = usesCart,
  shopTools = false,
} = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const product = localizeProduct(definition, locale);
const availability =
  product.availability === 'sold_out'
    ? t('売り切れ', 'Sold out')
    : product.checkoutUrl
      ? t('販売中', 'Available')
      : t('販売準備中', 'Coming soon');
---

<article
  id={`product-${product.slug}`}
  class={`product product-${product.slug}`}
  data-product={product.slug}
>
  <ProductGallery product={product} locale={locale} index={index} />
  <div class="product-body">
    <div class="product-meta">
      <span class="availability" data-availability
        >{cartEnabled ? t('販売準備中', 'Coming soon') : availability}</span
      >
      {
        shopTools && (
          <button
            type="button"
            class="product-save"
            data-save-product
            hidden
            aria-pressed="false"
            aria-label={t(
              `${product.name}をお気に入りに保存`,
              `Save ${product.name}`,
            )}
            data-save-label={t(
              `${product.name}をお気に入りに保存`,
              `Save ${product.name}`,
            )}
            data-remove-label={t(
              `${product.name}をお気に入りから削除`,
              `Remove ${product.name} from saved items`,
            )}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 20S3 14.5 3 8.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 9 1.5C21 14.5 12 20 12 20Z" />
            </svg>
          </button>
        )
      }
    </div>
    <h3>{product.name}</h3>
    <p>{product.description}</p>
    <div class="product-buy">
      <span class="price" data-price
        >{
          !cartEnabled && product.displayPriceJPY != null
            ? money(product.displayPriceJPY)
            : t('価格未定', 'Price to be announced')
        }</span
      >
      {
        cartEnabled ? (
          <button
            data-add={product.slug}
            disabled
            aria-label={t(
              `${product.name}をバッグに追加`,
              `Add ${product.name} to your bag`,
            )}
          >
            {t('準備中', 'Coming soon')}
          </button>
        ) : product.checkoutUrl ? (
          <a
            href={product.checkoutUrl}
            rel="noreferrer"
            aria-label={t(
              `${product.name}をStripeで購入する`,
              `Buy ${product.name} through Stripe`,
            )}
          >
            {t('購入する ↗', 'Buy now ↗')}
          </a>
        ) : (
          <button disabled>
            {product.availability === 'sold_out'
              ? t('売り切れ', 'Sold out')
              : t('準備中', 'Coming soon')}
          </button>
        )
      }
    </div>
  </div>
</article>
