---
import { usesCart } from '../data/checkout.mjs';
import { getLocale, translator } from '../data/i18n.mjs';
import { localizeProduct } from '../data/shop-i18n.mjs';
import { money } from '../scripts/cart.mjs';
const { product: definition, index = 0, cartEnabled = usesCart } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const product = localizeProduct(definition, locale);
const availability =
  product.availability === 'sold_out'
    ? t('売り切れ', 'Sold out')
    : product.checkoutUrl
      ? t('販売中', 'Available')
      : t('販売準備中', 'Coming soon');
---

<article class={`product product-${product.slug}`} data-product={product.slug}>
  <div class="product-art">
    <span class="product-number">0{index + 1}</span>
    <img
      src={product.image}
      width="900"
      height="400"
      loading="lazy"
      alt={product.imageAlt}
    />
    <span class="image-label">{product.imageLabel}</span>
  </div>
  <div class="product-body">
    <span class="availability" data-availability
      >{cartEnabled ? t('販売準備中', 'Coming soon') : availability}</span
    >
    <h3>{product.name}</h3>
    <p>{product.description}</p>
    <div class="product-buy">
      <span class="price" data-price
        >{
          !cartEnabled && product.displayPriceJPY != null
            ? money(product.displayPriceJPY)
            : t('価格未定', 'Price to be announced')
        }</span
      >
      {
        cartEnabled ? (
          <button
            data-add={product.slug}
            disabled
            aria-label={t(
              `${product.name}をバッグに追加`,
              `Add ${product.name} to your bag`,
            )}
          >
            {t('準備中', 'Coming soon')}
          </button>
        ) : product.checkoutUrl ? (
          <a
            href={product.checkoutUrl}
            rel="noreferrer"
            aria-label={t(
              `${product.name}をStripeで購入する`,
              `Buy ${product.name} through Stripe`,
            )}
          >
            {t('購入する ↗', 'Buy now ↗')}
          </a>
        ) : (
          <button disabled>
            {product.availability === 'sold_out'
              ? t('売り切れ', 'Sold out')
              : t('準備中', 'Coming soon')}
          </button>
        )
      }
    </div>
  </div>
</article>
