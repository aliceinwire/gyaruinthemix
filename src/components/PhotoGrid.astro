---
import { site } from '../data/site.mjs';

const { photos = site.photos } = Astro.props;
---

<div class="scrapbook">
  {
    photos.map((photo, i) => (
      <figure class={`snapshot snapshot-${i % 3}`}>
        <button
          class="photo-open"
          data-photo={photo.image}
          data-caption={photo.caption}
          aria-label={`${photo.caption} 写真を大きく見る`}
          aria-haspopup="dialog"
          aria-controls="photo-dialog"
        >
          <picture>
            <source
              type="image/avif"
              srcset={`${photo.image.replace('.webp', '-small.avif')} 540w, ${photo.image.replace('.webp', '.avif')} ${photo.width || (photo.image.includes('portrait') ? 1108 : 900)}w`}
              sizes="(max-width: 480px) 85vw, (max-width: 760px) 390px, (max-width: 1100px) 44vw, 550px"
            />
            <img
              src={photo.image}
              srcset={`${photo.image.replace('.webp', '-small.webp')} 540w, ${photo.image} ${photo.width || (photo.image.includes('portrait') ? 1108 : 900)}w`}
              sizes="(max-width: 480px) 85vw, (max-width: 760px) 390px, (max-width: 1100px) 44vw, 550px"
              alt={photo.alt}
              width={photo.width || 900}
              height={photo.height || 1200}
              loading="lazy"
              decoding="async"
            />
          </picture>
          <span class="photo-zoom" aria-hidden="true">
            ＋
          </span>
        </button>
        <figcaption>
          <>
            <span>{photo.tag}</span>
            <strong>{photo.caption}</strong>
          </>
        </figcaption>
      </figure>
    ))
  }
</div>
<dialog class="photo-dialog" id="photo-dialog" aria-labelledby="photo-caption">
  <button class="icon-button" data-photo-close aria-label="写真を閉じる"
    >×</button
  >
  <img id="photo-full" alt="" width="900" height="1200" />
  <p id="photo-caption"></p>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#photo-dialog')!;
  const full = document.querySelector<HTMLImageElement>('#photo-full')!;
  const caption = document.querySelector('#photo-caption')!;
  let opener: HTMLButtonElement | undefined;
  document
    .querySelectorAll<HTMLButtonElement>('[data-photo]')
    .forEach((button) => {
      button.addEventListener('click', () => {
        opener = button;
        full.src = button.dataset.photo!;
        const preview = button.querySelector('img')!;
        full.alt = preview.alt;
        full.width = preview.width;
        full.height = preview.height;
        caption.textContent = button.dataset.caption!;
        dialog.showModal();
      });
    });
  document
    .querySelector('[data-photo-close]')!
    .addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => opener?.focus());
</script>
