---
import { getSite } from '../data/site.mjs';
import { getLocale, translator } from '../data/i18n.mjs';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const site = getSite(locale);
---

<ol class="track-list">
  {
    site.tracks.map((track, i) => (
      <li>
        <span class="track-index" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <div>
          <>
            <h3>{track.title}</h3>
            <span class="track-meta">
              {track.url
                ? t('楽曲リンク', 'Track link')
                : t('配信情報は準備中', 'Release links coming soon')}
            </span>
          </>
        </div>
        {track.url ? (
          <a
            class="track-play"
            href={track.url}
            rel="noopener noreferrer"
            aria-label={`${track.title}：${track.linkLabel}`}
          >
            ↗
          </a>
        ) : (
          <span class="track-symbol" aria-hidden="true">
            ♡
          </span>
        )}
      </li>
    ))
  }
</ol>
