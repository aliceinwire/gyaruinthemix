---
import { getLocale, translator } from '../data/i18n.mjs';
const { testShop = false } = Astro.props;
const t = translator(getLocale(Astro.url.pathname));
---

<dialog
  id="cart-dialog"
  class="cart-dialog"
  aria-labelledby="cart-title"
  data-shop-scope={testShop ? 'test' : 'public'}
>
  <div class="cart-heading">
    <h2 id="cart-title">
      {testShop ? t('テスト用バッグ', 'Test bag') : t('マイバッグ', 'My bag')}
      <span aria-hidden="true">♡</span>
    </h2><button
      class="icon-button"
      data-close-cart
      aria-label={t('バッグを閉じる', 'Close bag')}>×</button
    >
  </div>
  <p id="cart-mode" class="notice" hidden={!testShop}>
    {
      t(
        'テストショップです。実際の購入・発送はありません。',
        'This is a test shop. No real purchases or shipping take place.',
      )
    }
  </p>
  <div id="cart-items"></div>
  <div class="cart-summary">
    <div>
      <span>{t('小計（税込）', 'Subtotal (tax included)')}</span><strong
        id="cart-subtotal">¥0</strong
      >
    </div><p id="cart-shipping" class="muted">
      {
        testShop
          ? t(
              'テスト専用です。実際のお支払い・商品の発送はありません。',
              'For testing only. No real payment or shipping takes place.',
            )
          : t(
              '送料は販売開始時にご案内します。',
              'Shipping costs will be announced when sales open.',
            )
      }
    </p>
  </div>
  <p id="cart-error" class="error" role="alert"></p>
  {
    testShop && (
      <>
        <p id="test-checkout-status" class="notice" role="status" />
        <button id="test-checkout-reset" class="text-button" hidden>
          {t(
            '結果とバッグを確認して、新しいテスト決済を始める',
            'Review the result and bag, then start a new test checkout',
          )}
        </button>
      </>
    )
  }
  <button class="button checkout" id="checkout" disabled>
    {
      testShop
        ? t('テスト決済へ進む', 'Continue to test checkout')
        : t('決済へ進む', 'Continue to checkout')
    }
    <span aria-hidden="true">↗</span>
  </button>
  <p class="cart-note">
    {
      testShop ? (
        <>
          {t(
            'Stripe Sandboxの動作確認専用です。',
            'For Stripe Sandbox testing only.',
          )}
          <br />
          {t(
            '実際のお支払い・商品の発送はありません。',
            'No real payment or shipping takes place.',
          )}
        </>
      ) : (
        <>
          {t(
            'お支払いはStripeの決済ページで。',
            'Payment is handled on Stripe’s checkout page.',
          )}
          <br />
          {t(
            'お届け先は日本国内のみです。',
            'Shipping is available within Japan only.',
          )}
        </>
      )
    }
  </p>
  <button class="text-button" data-close-cart
    >{t('お買い物を続ける', 'Continue shopping')}</button
  >
</dialog>
<p class="announcement" id="announcement" role="status" aria-live="polite"></p>
