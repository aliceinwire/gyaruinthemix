---
const { label, title, href, link = 'すべて見る' } = Astro.props;
---

<div class="section-heading editorial-heading">
  <div>
    <p class="eyebrow">{label}</p><h2>
      {title}<span aria-hidden="true">✦</span>
    </h2>
  </div>
  {
    href && (
      <a class="text-link" href={href}>
        {link} ↗
      </a>
    )
  }
</div>
