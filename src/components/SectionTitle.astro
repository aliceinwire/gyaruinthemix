---
import { getLocale, translator, localizePath } from '../data/i18n.mjs';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const { label, title, href, link = t('すべて見る', 'View all') } = Astro.props;
---

<div class="section-heading editorial-heading">
  <div>
    <p class="eyebrow">{label}</p><h2>
      {title}<span aria-hidden="true">✦</span>
    </h2>
  </div>
  {
    href && (
      <a class="text-link" href={localizePath(href, locale)}>
        {link} ↗
      </a>
    )
  }
</div>
