---
import Layout from '../layouts/Layout.astro';
import { getSite } from '../data/site.mjs';
import SoundIdentity from '../components/SoundIdentity.astro';
import { getLocale, translator, localizePath } from '../data/i18n.mjs';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const site = getSite(locale);
---

<Layout title={t('ふたりのこと｜ギャルインザミックス', 'About | GYARUINTHEMIX')}
  ><section class="about">
    <div class="about-image">
      <picture
        ><source type="image/avif" srcset="/assets/artists.avif" /><img
          src="/assets/artists.webp"
          width="900"
          height="1200"
          alt={t('DJありねぇとDJちゃな', 'DJ Arinee and DJ Chana')}
        /></picture
      >
    </div><div class="about-copy">
      <p class="eyebrow">
        {site.artist.aesthetic}{t('のDJユニット', ' DJ duo')}
      </p><h1>
        {t('ふたりで、', 'Together,')}<br /><em
          >{t('もっと強く。', 'even bolder.')}</em
        >
      </h1><p>
        {
          t(
            'ギャルインザミックス（GYARUINTHEMIX）は、DJありねぇとDJちゃなによるB2B\n        DJユニット。',
            'GYARUINTHEMIX is the B2B DJ duo of DJ Arinee and DJ Chana.',
          )
        }
      </p>
      <SoundIdentity /><p>
        {site.artist.genres.map((genre) => genre.label).join(t('と', ' and '))}{
          t('。', '.')
        }
        {site.artist.bpm}
        {
          t(
            'BPMで、フロアをぶちアゲ。跳ねるビートにラップを乗せて、平成ギャルのテンションをそのまま音に。',
            'BPM to light up the dance floor. Rap over bouncing beats, with Heisei gyaru energy turned all the way up.',
          )
        }
      </p><p>
        {
          t(
            '盛り髪も、ピンクも、ヒョウ柄も。好きなものは、好きなだけ盛る。かわいさも強さも譲らん、うちらのスタイル。',
            "Big hair, pink, and leopard print. More of everything we love. Cute and bold, without compromise. That's our style.",
          )
        }
      </p><div class="profile-members">
        {
          site.socials.slice(1).map((link) => (
            <a href={link.url} rel="noopener noreferrer">
              {link.label} ↗
            </a>
          ))
        }
      </div><a class="button" href={localizePath('/music/', locale)}
        >{t('うちらの音楽 ↗', 'Our music ↗')}</a
      >{
        site.bookingUrl && (
          <p class="booking-link">
            <a href={localizePath('/contact/', locale)}>
              {t('出演依頼・お問い合わせ ↗', 'Bookings & contact ↗')}
            </a>
          </p>
        )
      }
    </div>
  </section></Layout
>
