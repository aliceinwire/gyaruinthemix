---
import Layout from '../layouts/Layout.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { getSite } from '../data/site.mjs';
import { getLocale, translator, localizePath } from '../data/i18n.mjs';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const site = getSite(locale);
---

<Layout
  title={t('ファンクラブ｜ギャルインザミックス', 'Fan Club | GYARUINTHEMIX')}
>
  <section class="club-hero">
    <div class="club-title">
      <p class="eyebrow">
        {t('ギャルインザミックス ファンクラブ', 'GYARUINTHEMIX FAN CLUB')}
      </p><h1>
        {t('フロアの外も、', 'Beyond the floor,')}<br /><em
          >{t('ギャル集合。', 'gyaru unite.')}</em
        ><span aria-hidden="true">♡</span>
      </h1><p>
        {t('会える日も、会えない日も。', "Whether we're together or apart.")}<br
        />{
          t(
            '写真も近況も、ここでチェック。うちらと一緒に盛ってこ。',
            'Find our photos and latest news here. Go all out with us.',
          )
        }
      </p><a class="button" href="#photos"
        >{t('ふたりのフォトを見る ↘', 'Explore the photo gallery ↘')}</a
      >
    </div><div class="club-card">
      <span class="eyebrow">{t('ギャルインザミックス', 'GYARUINTHEMIX')}</span
      ><span class="club-card-heart" aria-hidden="true">♡</span><h2>
        {t('ファンクラブ', 'Fan club')}
      </h2>{
        site.fanClub.registrationOpen ? (
          <a
            class="button button-pink"
            href={site.fanClub.joinUrl}
            rel="noopener noreferrer"
          >
            {site.fanClub.joinLabel} ↗
          </a>
        ) : (
          <p class="club-status">
            {t('入会受付は準備中', 'Registration is in the works')}
          </p>
        )
      }<p>{site.fanClub.membershipNote}</p>
    </div>
  </section>
  <section class="section photo-section" id="photos">
    <SectionTitle
      label={t('盛れてる日も、踊ってる日も。', 'Glam days and dance days.')}
      title={t('ふたりのフォト', 'Photo gallery')}
    /><PhotoGrid /><p class="collection-note">
      {
        t(
          '写真をタップすると、大きく見られます。',
          'Tap a photo to see it full size.',
        )
      }
    </p>
  </section>
  <section class="section fan-links">
    <a href={localizePath('/news/', locale)}
      ><span>{t('01 / お知らせ', '01 / NEWS')}</span><h2>
        {t('うちらの近況 ↗', 'The latest from us ↗')}
      </h2><p>
        {
          t(
            'グッズやファンクラブのお知らせ。',
            'News about merch and the fan club.',
          )
        }
      </p></a
    ><a href={localizePath('/live/', locale)}
      ><span>{t('02 / 出演情報', '02 / APPEARANCES')}</span><h2>
        {t('次に会える場所 ↗', 'Where to see us next ↗')}
      </h2><p>
        {
          t(
            'DJ出演とメディア情報をチェック。',
            'Check our DJ and media appearances.',
          )
        }
      </p></a
    >
  </section>
  <section class="section club-faq">
    <SectionTitle
      label={t('参加する前に。', 'Before you join.')}
      title={t('よくある質問', 'Frequently asked questions')}
    /><details>
      <summary
        >{
          t(
            '写真を見るのに登録は必要？',
            'Do I need to register to view the photos?',
          )
        }</summary
      ><p>
        {
          t(
            'このページの写真とお知らせは、登録なしでご覧いただけます。',
            'The photos and news on this page are available without registration.',
          )
        }
      </p>
    </details><details>
      <summary
        >{
          t('ファンクラブにはどうやって入るの？', 'How do I join the fan club?')
        }</summary
      ><p>
        {
          site.fanClub.registrationOpen
            ? t(
                '上の入会案内から、受付先の条件・プライバシーポリシーをご確認のうえお手続きください。',
                'Use the joining link above, and review the registration provider’s terms and privacy policy before signing up.',
              )
            : t(
                '現在は入会受付の準備中です。受付を始めるときに、このページで入会方法をご案内します。',
                'Registration is currently being prepared. We will explain how to join on this page when registration opens.',
              )
        }
      </p>
    </details><details>
      <summary>{t('会費や特典は？', 'What are the fees and benefits?')}</summary
      ><p>{site.fanClub.membershipNote}</p>
    </details>
  </section>
</Layout>
