---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import MusicVideos from '../components/MusicVideos.astro';
import Events from '../components/Events.astro';
import SoundIdentity from '../components/SoundIdentity.astro';
import { getSite } from '../data/site.mjs';
import { getLocale, translator, localizePath } from '../data/i18n.mjs';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const site = getSite(locale);
---

<Layout>
  <section class="unit-hero">
    <div class="unit-hero-copy">
      <p class="eyebrow">
        {site.artist.aesthetic}♡ {
          t('DJありねぇ ＋ DJちゃな / B2B', 'DJ Arinee + DJ Chana / B2B')
        }
      </p>
      <h1>
        <span>{t('盛って、', 'Glam up.')}</span><br /><em
          >{t('ぶちアゲ。', 'Turn it up.')}</em
        >
      </h1>
      <p class="unit-intro">
        {t('盛り髪、ピンク、ヒョウ柄。', 'Big hair. Pink. Leopard print.')}<br
        />{
          t(
            '好きな自分で、爆音のど真ん中へ。',
            'Be your boldest self, right in the middle of the sound.',
          )
        }<br />{
          t(
            '跳ねるビートもラップも、うちら全開。',
            'Bouncing beats and our own rap. All of us, all the way.',
          )
        }
      </p>
      <SoundIdentity />
      <div class="hero-actions">
        <a class="button button-pink" href={localizePath('/music/', locale)}
          >{t('うちらの音楽 ', 'Our music ')}<span aria-hidden="true">↗</span
          ></a
        ><a class="hero-live-link" href={localizePath('/live/', locale)}
          >{t('出演情報 ↗', 'Appearances ↗')}</a
        >
      </div>
      <p class="hero-contact-links">
        <a href={site.bookingUrl} rel="noopener noreferrer"
          >{t('公式Instagram ↗', 'Official Instagram ↗')}</a
        >
        <a href={localizePath('/contact/', locale)}
          >{t('出演依頼・お問い合わせ ↗', 'Bookings & contact ↗')}</a
        >
      </p>
    </div>
    <div class="unit-hero-image">
      <picture
        ><source
          type="image/avif"
          srcset="/assets/portrait-small.avif 540w, /assets/portrait.avif 1108w"
          sizes="(max-width: 760px) 100vw, 55vw"
        /><img
          src="/assets/portrait.webp"
          srcset="/assets/portrait-small.webp 540w, /assets/portrait.webp 1108w"
          sizes="(max-width: 760px) 100vw, 55vw"
          width="1108"
          height="1477"
          fetchpriority="high"
          alt={t(
            'ピンクの衣装で寄り添うDJちゃなとDJありねぇ',
            'DJ Chana and DJ Arinee leaning together in pink outfits',
          )}
        /></picture
      ><span class="photo-label"
        >{t('かわいく、強く、うちららしく。', 'Cute. Bold. Always us.')}</span
      >
    </div>
    <span class="chrome-heart" aria-hidden="true">♡</span>
    <div class="hero-brand">
      <img
        src="/assets/logo.webp"
        width="1200"
        height="400"
        alt={t('ギャルインザミックス', 'GYARUINTHEMIX')}
      />
    </div>
  </section>
  <div class="leopard-ribbon" aria-hidden="true">
    <div>
      {
        t(
          '盛り髪。爆音。ギャルマインド。',
          'Big hair. Big sound. Gyaru spirit.',
        )
      }<span>♥</span>{t('フロアで会お。', 'See you on the floor.')}<span
        >♥</span
      >{
        t(
          '盛り髪。爆音。ギャルマインド。',
          'Big hair. Big sound. Gyaru spirit.',
        )
      }
    </div>
  </div>
  <section class="section news-section">
    <SectionTitle
      label={t('近況、チェックしてこ。', 'Catch up with us.')}
      title={t('お知らせ', 'News')}
      href={localizePath('/news/', locale)}
    />
    <div class="news-list">
      {
        site.news.slice(0, 3).map((item) => (
          <a href={localizePath(item.url, locale)} class="news-row">
            <>
              <span class="news-category">{item.category}</span>
              <h3>{item.title}</h3>
              <span aria-hidden="true">↗</span>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section class="sound-section">
    <div class="section sound-grid">
      <div class="sound-cover">
        <picture
          ><source type="image/avif" srcset="/assets/live.avif" /><img
            src="/assets/live.webp"
            width="900"
            height="1200"
            loading="lazy"
            alt={t(
              'DJブースでプレイするふたり',
              'The duo performing in a DJ booth',
            )}
          /></picture
        ><div>
          <span class="eyebrow"
            >{
              t('跳ねるビートに、うちらの声。', 'Bouncing beats. Our voices.')
            }</span
          ><p>
            {t('音も、', 'The sound?')}<br /><em
              >{t('盛ってこ。', 'Go all out.')}</em
            >
          </p>
        </div><span class="sound-sticker" aria-hidden="true"
          >{site.artist.bpm}<br /><small>BPM</small></span
        >
      </div><div class="sound-copy">
        <SectionTitle
          label={site.artist.genres.map((genre) => genre.label).join(' × ')}
          title={t('うちらの音楽', 'Our music')}
        /><MusicVideos featured /><a
          class="text-link"
          href={localizePath('/music/', locale)}
          >{
            t(
              'すべてのミュージックビデオを見る ↗',
              'Watch all music videos ↗',
            )
          }</a
        >
        <p>
          <a
            class="text-link"
            href={site.soundcloudUrl}
            rel="noopener noreferrer"
            >{t('SoundCloudで聴く ', 'Listen on SoundCloud ')}<span
              aria-hidden="true">↗</span
            ></a
          >
        </p>
      </div>
    </div>
  </section>
  <section class="section">
    <SectionTitle
      label={t('次は、フロアで。', 'Next stop: the dance floor.')}
      title={t('出演情報', 'Appearances')}
      href={localizePath('/live/', locale)}
    /><Events period="upcoming" />
  </section>
  <section class="section photo-section">
    <SectionTitle
      label={t('フロアの外も、うちら全開。', 'All of us, beyond the floor.')}
      title={t('ふたりのフォト', 'Photo gallery')}
      href={localizePath('/fanclub/#photos', locale)}
    />
    <PhotoGrid photos={site.photos.slice(0, 4)} />
    <p class="collection-note">
      {
        t(
          '写真をタップして、大きく見てね。♡',
          'Tap a photo for a closer look. ♡',
        )
      }
    </p>
  </section>
  <section class="fan-banner">
    <div class="fan-banner-inner">
      <div>
        <p class="eyebrow">
          {t('ギャルインザミックス ファンクラブ', 'GYARUINTHEMIX FAN CLUB')}
        </p><h2>
          {t('フロアの外でも、', 'Beyond the floor,')}<br /><em
            >{t('ギャル集合。', 'gyaru unite.')}</em
          >
        </h2><p>
          {
            t(
              'ふたりの写真も、次に会える予定も。',
              'Our photos. Our next appearances.',
            )
          }<br />{
            t(
              '会えない日だって、一緒に盛ってこ。',
              "Even when we're apart, let's go all out together.",
            )
          }
        </p><a class="button" href={localizePath('/fanclub/', locale)}
          >{t('ファンページへ ', 'Visit the fan page ')}<span aria-hidden="true"
            >♡</span
          ></a
        >
      </div><div class="fan-postcard" aria-hidden="true">
        <img
          src="/assets/artists-small.webp"
          width="540"
          height="720"
          loading="lazy"
          alt=""
        /><span>{t('うちらと、みんなで。♡', 'Us and all of you. ♡')}</span>
      </div>
    </div>
  </section>
  <section class="section goods-teaser">
    <div>
      <p class="eyebrow">{t('いつでも、一緒に。', 'With you, wherever.')}</p><h2
      >
        {t('うちらのグッズ', 'Our merch')}<span aria-hidden="true">♡</span>
      </h2><p>
        {t('あの日のテンション、連れて帰ろ。', 'Take that feeling home.')}<br
        />{
          t(
            'オフィシャルグッズは、ただいま販売準備中。',
            'Official merch is being prepared for sale.',
          )
        }
      </p><a class="text-link" href={localizePath('/shop/', locale)}
        >{t('グッズを見に行く ↗', 'Explore the merch ↗')}</a
      >
    </div><a
      class="goods-art"
      href={localizePath('/shop/', locale)}
      aria-label={t('グッズを見る', 'Explore the merch')}
      ><img
        src="/assets/banner.webp"
        width="1536"
        height="657"
        loading="lazy"
        alt={t(
          'ふたりの写真とロゴのアートワーク',
          "Artwork featuring the duo's photo and logo",
        )}
      /><span
        >{
          t(
            'ロゴステッカー / タオル / キーホルダー',
            'Logo stickers / Towels / Keychains',
          )
        }</span
      ></a
    >
  </section>
</Layout>
