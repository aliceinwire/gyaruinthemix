---
import Layout from '../layouts/Layout.astro';
import { getSite } from '../data/site.mjs';
import { getLocale, translator, localizePath } from '../data/i18n.mjs';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const site = getSite(locale);
---

<Layout title={t('お知らせ｜ギャルインザミックス', 'News | GYARUINTHEMIX')}
  ><section class="page-heading">
    <p class="eyebrow">{t('うちらの、いま。', 'The latest from us.')}</p><h1>
      {t('お知らせ', 'News')}<span aria-hidden="true">✦</span>
    </h1>
  </section><section class="section news-articles">
    {
      site.news.map((item) => (
        <article>
          <>
            <div>
              <span class="news-category">{item.category}</span>
              {item.date && (
                <time datetime={item.date}>
                  {item.date.replaceAll('-', '.')}
                </time>
              )}
            </div>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
            <a class="text-link" href={localizePath(item.url, locale)}>
              {t('詳しく見る ↗', 'Read more ↗')}
            </a>
          </>
        </article>
      ))
    }
  </section></Layout
>
