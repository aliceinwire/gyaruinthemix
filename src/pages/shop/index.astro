---
import Layout from '../../layouts/Layout.astro';
import Product from '../../components/Product.astro';
import ShopHero from '../../components/ShopHero.astro';
import ShopBrowse from '../../components/ShopBrowse.astro';
import ShopHelp from '../../components/ShopHelp.astro';
import { products, usesCart, paymentLinks } from '../../data/checkout.mjs';
import { getLocale, localizePath, translator } from '../../data/i18n.mjs';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const linksOpen = !usesCart && products.some((product) => product.checkoutUrl);
---

<Layout
  title={t('グッズ｜ギャルインザミックス', 'Merchandise | GYARUINTHEMIX')}
>
  <section
    class="section shop-section"
    data-shop-discovery
    data-online-sales={!usesCart && paymentLinks.salesEnabled
      ? 'open'
      : 'paused'}
    data-saved-key="gyaru-shop-favorites-v1"
  >
    <div class="shop-notice">
      <strong>
        {
          t(
            'グッズをゲットするなら、ギャルインザミックスの出演イベントがおすすめやで！',
            'The best place to get GYARUINTHEMIX merch is at our shows.',
          )
        }
      </strong>
      <p data-sales-paused>
        {
          t(
            'オンライン販売は現在休止中です。再開時期は未定です。',
            'Online sales are paused. We haven’t set a reopening date.',
          )
        }
      </p>
      <a href={localizePath('/live/', locale)}
        >{t('出演スケジュールを見る', 'See our event schedule')}</a
      >
    </div>
    <ShopHero products={products} locale={locale} />
    <p id="catalog-status" class="notice" role="status" hidden={!linksOpen}>
      {
        linksOpen &&
          (paymentLinks.mode === 'test'
            ? t(
                'テストショップです。実際の購入・発送はありません。',
                'This is a test shop. No real purchases or shipping take place.',
              )
            : t(
                '商品・セットごとに、Stripeの決済ページでご購入いただけます。表示価格は税込です。',
                'Each item or set can be purchased through Stripe checkout. Displayed prices include tax.',
              ))
      }
    </p>{
      usesCart && (
        <noscript>
          <p class="notice">
            {t(
              'オンライン注文の受付状況を確認するには、JavaScriptを有効にしてください。',
              'Enable JavaScript to check whether online ordering is available.',
            )}
          </p>
        </noscript>
      )
    }
    <ShopBrowse count={products.length} locale={locale} />
    <div class="product-grid">
      {
        products.map((product, index) => (
          <Product product={product} index={index} shopTools />
        ))
      }
    </div><p class="collection-note">
      {
        t(
          'ロゴシールは実物写真を掲載しています。',
          'The logo sticker gallery shows the actual stickers.',
        )
      }
    </p><div class="shop-info" id="shop-guide" data-online-orders>
      <div>
        <b>{t('お届けについて', 'Shipping')}</b><p>
          {
            t(
              'お届け先は日本国内のみです。送料は決済ページで、発送時期は特定商取引法に基づく表記でご確認ください。',
              'Shipping is available within Japan only. Check checkout for shipping costs and our commerce disclosure for dispatch timing.',
            )
          }
        </p>
      </div><div>
        <b>{t('お支払いについて', 'Payment')}</b><p>
          {
            t(
              'お支払いはStripeの決済ページで。クレジットカード情報を当サイトに入力することはありません。',
              'Payment is handled on Stripe’s checkout page. You will never enter credit card details on this website.',
            )
          }
        </p>
      </div>
    </div>
    <p class="collection-note">
      {
        t(
          'イメージ画像（実物と細部が異なる場合があります）',
          'Illustrative image (details may differ from the actual product)',
        )
      }
    </p>
    <ShopHelp locale={locale} />
  </section>
</Layout>

<style>
  .shop-notice {
    margin: 0 0 24px;
    padding: 20px clamp(16px, 4vw, 32px);
    background: #b9005a;
    color: #fff;
    border: 2px solid currentColor;
    outline: 2px solid #b9005a;
    line-height: 1.6;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .shop-notice strong {
    display: block;
    font-size: clamp(1.125rem, 3vw, 1.75rem);
    text-wrap: balance;
  }
  .shop-notice p {
    margin: 0.5rem 0 0;
  }
  .shop-notice a {
    display: inline-block;
    margin-top: 0.5rem;
  }
  .shop-notice a:focus-visible {
    outline-color: currentColor;
  }
</style>
