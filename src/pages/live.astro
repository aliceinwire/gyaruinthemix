---
import Layout from '../layouts/Layout.astro';
import Events from '../components/Events.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { site } from '../data/site.mjs';
import { selectEvents } from '../data/events.mjs';
const now = new Date();
const cancellations = selectEvents(site.events, { period: 'cancelled', now });
---

<Layout title="出演情報｜ギャルインザミックス">
  <section class="page-heading">
    <p class="eyebrow">フロアでも、画面の向こうでも。</p>
    <h1>次は、<em>どこで会う？</em></h1>
    <p>これからの予定も、これまでの思い出も。</p>
  </section>
  <section class="section schedule-section">
    <SectionTitle label="フロアで会お。" title="今後のDJ出演" />
    <Events category="live" {now} />
    <div class="media-section">
      <SectionTitle label="ふたりをチェック。" title="今後のメディア出演" />
      <Events category="media" {now} />
    </div>
    {
      cancellations.length > 0 && (
        <div class="media-section">
          <SectionTitle
            label="ご来場前に確認してね。"
            title="出演変更のお知らせ"
          />
          <Events period="cancelled" {now} />
        </div>
      )
    }
    <p class="collection-note">
      日付・時間は日本時間です。開催日時・入場条件・チケットは、各イベントの公式案内をご確認ください。
    </p>
    {
      site.bookingUrl && (
        <a class="button booking-link" href="/contact/">
          出演依頼・お問い合わせ ↗
        </a>
      )
    }
    <div class="media-section">
      <SectionTitle label="あの夜も、うちららしく。" title="これまでの出演" />
      <Events period="past" {now} />
    </div>
  </section>
</Layout>
