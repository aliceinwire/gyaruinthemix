---
import Layout from '../layouts/Layout.astro';
import TrackList from '../components/TrackList.astro';
import MusicVideos from '../components/MusicVideos.astro';
import { getSite } from '../data/site.mjs';
import SoundIdentity from '../components/SoundIdentity.astro';
import { getLocale, translator, localizePath } from '../data/i18n.mjs';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const site = getSite(locale);
---

<Layout title={t('音楽｜ギャルインザミックス', 'Music | GYARUINTHEMIX')}>
  <section class="page-heading dark-heading">
    <p class="eyebrow">
      {site.artist.aesthetic}{t('、音まで全開。', ', turned all the way up.')}
    </p><h1>
      {t('跳ねて、', 'Bounce. ')}<em>{t('ぶちアゲ。', 'Turn it up.')}</em>
    </h1><SoundIdentity /><p>
      {
        t(
          '跳ねるビート。うちらのラップ。DJありねぇとDJちゃなの音、ここに集合。',
          'Bouncing beats. Our rap. The sounds of DJ Arinee and DJ Chana, all here.',
        )
      }
    </p>
  </section>
  <section class="section" aria-labelledby="music-videos-title">
    <p class="eyebrow">
      {
        t(
          '公式YouTubeから、うちらの音。',
          'Our sound, from our official YouTube.',
        )
      }
    </p>
    <h2 id="music-videos-title">
      {t('うちらのミュージックビデオ', 'Our music videos')}
    </h2>
    <MusicVideos />
    <p>
      <a class="text-link" href={site.soundcloudUrl} rel="noopener noreferrer"
        >{t('SoundCloudで聴く ', 'Listen on SoundCloud ')}<span
          aria-hidden="true">↗</span
        ></a
      >
    </p>
  </section>
  <section class="section music-layout">
    <div class="music-portrait">
      <img
        src="/assets/live.webp"
        width="900"
        height="1200"
        alt={t(
          'DJブースでプレイするギャルインザミックス',
          'GYARUINTHEMIX performing in a DJ booth',
        )}
      /><span
        >{
          t('ふたりの音。うちらのスタイル。', 'Two DJs. Our sound. Our style.')
        }</span
      >
    </div><div>
      <p class="eyebrow">{t('うちらの楽曲', 'Our tracks')}</p><h2>
        {t('ギャルマインド、鳴らしてこ。', 'Let that gyaru spirit play.')}
      </h2><TrackList />{
        !site.tracks.some((track) => track.url) && (
          <p class="collection-note">
            {t(
              '上記のミュージックビデオは公開中です。こちらの楽曲の試聴・配信リンクは、公開の準備ができ次第ご案内します。',
              'The music videos above are available now. Preview and streaming links for the tracks listed here will be added when they are ready.',
            )}
          </p>
        )
      }<a class="button" href={localizePath('/live/', locale)}
        >{t('出演情報を見る ↗', 'See our appearances ↗')}</a
      >
    </div>
  </section>
</Layout>
